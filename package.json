{
  "name": "santinho",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run paginas",
    "paginas": "vite build --ssr scripts/paginas/entrada.ts --outDir dist-paginas --emptyOutDir && node scripts/paginas/gerar.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "verificar": "npm run typecheck && npm test && npm run build",
    "cap:sync": "vite build && cap sync",
    "gerar": "node scripts/gerar-lecionario.mjs",
    "gerar:biblia": "node scripts/gerar-biblia.mjs",
    "gerar:santos": "node --experimental-strip-types scripts/santos/imagens.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.10",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.10",
    "@electric-sql/pglite": "^0.3.16",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
